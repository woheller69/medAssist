<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:fitsSystemWindows="true"
    android:id="@+id/rootLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        tools:context="com.seemless.MainActivity">

        <!-- Language Row -->
        <LinearLayout
            android:id="@+id/langRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Source -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Source"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingBottom="2dp" />

                <Spinner
                    android:id="@+id/spinnerSource"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:backgroundTint="@color/colorAccent"
                    android:background="@android:drawable/btn_dropdown" />

                <EditText
                    android:id="@+id/etvCustomSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. de-DE"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:inputType="text|textNoSuggestions" />
            </LinearLayout>

            <!-- Swap -->
            <ImageButton
                android:id="@+id/btnSwap"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="4dp"
                android:src="@drawable/swap_32dp"
                android:background="@null"
                android:contentDescription="Swap languages" />

            <!-- Target -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Target"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingBottom="2dp" />

                <Spinner
                    android:id="@+id/spinnerTarget"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:backgroundTint="@color/colorAccent"
                    android:background="@android:drawable/btn_dropdown"/>

                <EditText
                    android:id="@+id/etvCustomTarget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. de-DE"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:inputType="text|textNoSuggestions" />
            </LinearLayout>
        </LinearLayout>

        <!-- Input Panel -->
        <ScrollView
            android:id="@+id/scroll_input"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_button_frame"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etvInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:textSize="16sp"
                android:padding="12dp"
                android:inputType="textNoSuggestions|textMultiLine"
                android:hint="Enter text to translate…"
                android:minHeight="120dp" />
        </ScrollView>

        <!-- Output Panel -->
        <ScrollView
            android:id="@+id/scroll_output"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginVertical="5dp"
            android:background="@drawable/rounded_button_frame"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:textSize="16sp"
                android:padding="12dp"
                android:textIsSelectable="true"
                android:inputType="textNoSuggestions|textMultiLine"
                android:hint="Translation…"
                android:minHeight="120dp" />
        </ScrollView>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:visibility="invisible"
            android:indeterminateTint="@color/colorAccent"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal">
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/inputButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:backgroundTint="@color/colorAccent"
                android:src="@drawable/mic_48dp"
                android:contentDescription="Record"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/translateButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:backgroundTint="@color/colorAccent"
                android:src="@drawable/translate_48dp"
                android:contentDescription="Translate"
                android:layout_marginBottom="10dp" />
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/ttsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:backgroundTint="@color/colorAccent"
                android:src="@drawable/voice_48dp"
                android:contentDescription="TextToSpeech"
                android:layout_marginBottom="10dp" />

        </LinearLayout>


    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
